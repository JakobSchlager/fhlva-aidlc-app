# Run settings for the in-cluster Job. Edit, then re-apply: see load/README.md.
PROFILE=smoke
RATE=2
DURATION=5m
SPIKE_FACTOR=5
USERS=20
WRITE_RATIO=0.3
# Targets: the services directly, by their in-cluster names (Helm release "beer-tracker").
# To go through the ingress instead, set BASE_URL and remove the four lines below.
BASE_URL=http://beer-tracker-frontend:80
AUTH_URL=http://beer-tracker-auth-service:8081
TRACKING_URL=http://beer-tracker-beer-tracking-service:8082
STATISTICS_URL=http://beer-tracker-statistics-service:8084
NOTIFICATIONS_URL=http://beer-tracker-health-notification-service:8083
