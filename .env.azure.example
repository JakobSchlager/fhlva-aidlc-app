# =============================================================================
# Beer Tracker — Azure Deployment Configuration (.env.azure)
# =============================================================================
# Copy this file to .env.azure and customize your values.
# The .env.azure file is gitignored and contains environment-specific settings.
#
# Used by:
#   - scripts/deploy-azure.ps1
#   - scripts/destroy-azure.ps1
# =============================================================================

# --- Azure Subscription & Location -------------------------------------------
# Leave AZURE_SUBSCRIPTION_ID blank to use currently active az login subscription.
AZURE_SUBSCRIPTION_ID=

# Azure region for all resources (VNet, AKS, ACR, Log Analytics, Storage).
# NOTE: Azure for Students subscriptions enforce an Azure Policy restricting deployment
# regions to: spaincentral, francecentral, norwayeast, swedencentral, germanywestcentral.
# Among these, swedencentral supports Standard_D2s_v3 for AKS (whereas germanywestcentral restricts it).
AZURE_LOCATION=swedencentral

# --- Naming Prefix & Environment ---------------------------------------------
# Base project name and environment.
# NOTE: Azure Storage Accounts and ACR registries require GLOBALLY UNIQUE names.
# Customize AZURE_PROJECT_NAME (e.g. fhooe-aidlc-<your-alias>) to avoid collisions.
AZURE_PROJECT_NAME=fhooe-aidlc-sc
AZURE_ENVIRONMENT=dev

# Custom suffix for globally unique resources (e.g. user initials or alias like 'pst').
# Used to ensure global uniqueness for ACR (e.g. fhooeaidlcscdevacrpst), AKS dns_prefix,
# and storage account fallback name.
AZURE_CUSTOM_SUFFIX=

# Explicit ACR name override (optional). Must be 5-50 lowercase alphanumeric characters.
# If omitted, derived from ${AZURE_PROJECT_NAME}${AZURE_ENVIRONMENT}acr${AZURE_CUSTOM_SUFFIX}.
AZURE_ACR_NAME=

# Deployment Resource Group (Terraform dev stage uses ${AZURE_PROJECT_NAME}-${AZURE_ENVIRONMENT}-rg)
AZURE_RESOURCE_GROUP=fhooe-aidlc-sc-dev-rg

# Log Analytics Workspace (Terraform dev stage uses ${AZURE_PROJECT_NAME}-${AZURE_ENVIRONMENT}-law)
AZURE_WORKSPACE_NAME=fhooe-aidlc-sc-dev-law

# --- Terraform Remote State Bootstrap -----------------------------------------
# Resource group holding the Terraform state storage account.
# By default, this is identical to AZURE_RESOURCE_GROUP so that ALL resources
# live in ONE single user-managed resource group (simplifying management and cleanup).
AZURE_TFSTATE_RG=fhooe-aidlc-sc-dev-rg

# Globally unique Azure storage account name (3-24 lowercase letters and numbers only).
# If left blank, deploy-azure.ps1 auto-generates a unique name based on project and subscription.
AZURE_STORAGE_ACCOUNT=fhooeaidlcscst

# Blob container name inside the state storage account.
AZURE_STORAGE_CONTAINER=tfstate

# --- AKS Cluster Sizing -------------------------------------------------------
# Default system node pool VM size.
# NOTE: "Azure for Students" subscriptions typically have a quota of 4 vCPUs for
# the DSv3 family and 6 vCPUs total regional. Standard_D2s_v3 (2 vCPUs, 8 GB RAM)
# with 2 nodes consumes exactly 4 vCPUs and fits the quota.
AKS_VM_SIZE=Standard_D2s_v3
AKS_NODE_MIN_COUNT=2
AKS_NODE_MAX_COUNT=2

# --- ACR & Ingress Sizing (Cost Optimization) ---------------------------------
# Container Registry SKU (Basic: ~€5/mo vs Standard: ~€20/mo)
ACR_SKU=Basic

# Application Gateway autoscale capacity bounds (min=0 saves capacity unit idle charges)
APPGW_MIN_CAPACITY=0
APPGW_MAX_CAPACITY=2

# --- Application Secrets ------------------------------------------------------
# Passwords and keys. If left blank, deploy-azure.ps1 will generate secure random values.
POSTGRES_APP_PASSWORD=
INTERNAL_API_KEY=

# Path to the RSA private key PEM file for JWT token signing.
# deploy-azure.ps1 automatically generates this key if the file does not exist.
AUTH_RSA_KEY_PATH=secrets/auth-rs256-private-key.pem

# --- Network & Security Whitelisting -----------------------------------------
# Comma-separated CIDR ranges allowed to reach the AKS API server and App Gateway.
# If left blank, deploy-azure.ps1 automatically detects your current public IP (/32)
# and appends it alongside the standard university ACONET ranges.
ADDITIONAL_ALLOWED_IPS=

# Alert email address for Azure Monitor alerts.
ALERT_EMAIL_ADDRESS=platform@example.com

# --- Dynatrace Monitoring ----------------------------------------------------
# Set to true to deploy the Dynatrace Operator and apply charts/dynakube.yaml.
ENABLE_DYNATRACE=true
