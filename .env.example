# ============================================================
# Beer Tracker — Local Development Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must NEVER be committed.
#
# Used by:
#   - docker-compose.yml / podman-compose (Scenario 1)
#   - scripts/deploy-minikube.sh (Scenario 2)
# ============================================================

# PostgreSQL superuser password.
# Used by all services as their database password.
# Change this to any strong password for local dev.
POSTGRES_PASSWORD=changeme

# Internal API key shared by all backend services for inter-service calls.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=changeme

# Path to the RSA private key PEM file (used by deploy-minikube.sh to create
# the auth-service Kubernetes Secret). The key itself is bind-mounted in compose.
# Generate with: openssl genrsa -out secrets/auth-rs256-private-key.pem 2048
AUTH_RSA_KEY_PATH=./secrets/auth-rs256-private-key.pem
